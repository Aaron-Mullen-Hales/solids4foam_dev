FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      lawProperties.gtfOneFamily;
}

type                 GultekinTwoFibreElastic;
rho                  rho [1 -3 0 0 0 0 0] 1000;
mu                   mu  [1 -1 -2 0 0 0 0] 1e4;
k1                   k1  [1 -1 -2 0 0 0 0] 5e5;
k2                   k2  [0 0 0 0 0 0 0] 2;
bulkModulus          K   [1 -1 -2 0 0 0 0] 1.0e6;
fibreField1          f0;
faceFibreField1      f0f;
anisotropicSplit     false;
fibresTensionOnly    false;
useSecondFibreFamily false;
implicitShearModulus implicitShearModulus [1 -1 -2 0 0 0 0] 1.01e6;
impKcoeff            1.0;
writeDiagnostics     false;
