SOLIDS4FOAM_ROOT := ../../..

sinclude $(SOLIDS4FOAM_ROOT)/etc/wmake-options
sinclude $(SOLIDS4FOAM_ROOT)/../etc/wmake-options

EXE_INC = \
    -Wno-old-style-cast \
    -Wno-deprecated-declarations \
    $(VERSION_SPECIFIC_INC) \
    -I$(SOLIDS4FOAM_ROOT)/ThirdParty/eigen3 \
    -I$(SOLIDS4FOAM_ROOT)/src/blockCoupledSolids4FoamTools/lnInclude \
    -I$(SOLIDS4FOAM_ROOT)/src/solids4FoamModels/lnInclude \
    -I$(LIB_SRC)/finiteVolume/lnInclude \
    -I$(LIB_SRC)/meshTools/lnInclude \
    -I$(LIB_SRC)/dynamicFvMesh/lnInclude \
    -I$(LIB_SRC)/dynamicMesh/lnInclude \
    -I$(LIB_SRC)/dynamicMesh/dynamicFvMesh/lnInclude \
    -I$(LIB_SRC)/dynamicMesh/dynamicMesh/lnInclude \
    -I$(LIB_SRC)/dynamicMesh/dynamicFvMesh/lnInclude \
    -I$(LIB_SRC)/dynamicMesh/lnInclude

ifdef PETSC_DIR
    EXE_INC += \
        -DUSE_PETSC \
        -I$(MPI_ARCH_PATH)/include \
        -I$(PETSC_DIR)/include \
        -I$(PETSC_DIR)/$(PETSC_ARCH)/include
endif

EXE_LIBS = \
    -Wl,-rpath,$(FOAM_LIBBIN) \
    -Wl,-rpath,$(FOAM_MODULE_LIBBIN) \
    -L$(FOAM_MODULE_LIBBIN) \
    -lsolids4FoamModels \
    -lfiniteVolume \
    -ldynamicFvMesh \
    -ldynamicMesh \
    -lmeshTools

ifdef PETSC_DIR
    EXE_LIBS += \
        -L$(PETSC_DIR)/$(PETSC_ARCH)/lib -lpetsc \
        -L$(MPI_ARCH_PATH)/lib -lmpi
endif
