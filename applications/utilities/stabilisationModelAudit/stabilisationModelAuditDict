FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      stabilisationModelAuditDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

model
{
    type                    RhieChow;
    scaleFactor             1.0;
    scaleFactorJacobian     1.0;
}

field               translation;
gradient            exact;

translation         (0.01 -0.02 0.03);
omega               (0.04 -0.03 0.02);
affineTensor        (0.07 -0.05 0.04  -0.02 -0.03 0.06  0.05 0.01 0.02);
smoothAmplitude     (0.02 -0.015 0.01);
smoothFrequency     (1 1 1);
checkerboardAmplitude (0.01 -0.006 0.004);
checkerboardCells   (8 8 8);

writeFields         false;
